# Copy to .env and adjust. .env is gitignored and must never be committed.

# --- Market data -------------------------------------------------------------
# Which provider the CLI and API use by default: yfinance | fixture
OPTIONS_PROVIDER=yfinance

# Optional keys for alternative providers. yfinance needs none; these slots exist
# so swapping the provider stays a one-file change (see providers/base.py).
POLYGON_API_KEY=
TRADIER_API_KEY=

# --- Pricing assumptions -----------------------------------------------------
# Annualised continuously-compounded risk-free rate used by Black-Scholes.
# Ignored when OPTIONS_FETCH_RISK_FREE_RATE=true.
OPTIONS_RISK_FREE_RATE=0.04
# Fetch the 13-week T-bill (^IRX) and use it as the risk-free rate instead.
OPTIONS_FETCH_RISK_FREE_RATE=false
# Continuous dividend yield assumed for every underlying. See README Limitations.
OPTIONS_DIVIDEND_YIELD=0.0

# --- IV rank -----------------------------------------------------------------
# Trailing window for IV rank/percentile, in stored snapshot days.
OPTIONS_IV_WINDOW_DAYS=252
# Minimum stored days before an IV rank is reported at all. Below this the API
# returns null with a reason rather than a misleading zero.
OPTIONS_MIN_HISTORY_DAYS=20

# --- Storage -----------------------------------------------------------------
OPTIONS_DATABASE_URL=sqlite:///./data/options.db

# --- Web ---------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
