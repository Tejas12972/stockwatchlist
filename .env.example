# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# Every value here has a working default, so a clean clone runs with no .env at
# all. The ones that matter for a real deployment are marked.

# --- Market data -------------------------------------------------------------
# yfinance | fixture   ("fixture" replays the checked-in capture: offline, stale,
# and deterministic — useful for demos when Yahoo is throttling.)
OPTIONS_PROVIDER=yfinance

# Optional keys for alternative providers. yfinance needs none; these slots exist
# so swapping the provider stays a one-file change (see providers/base.py).
POLYGON_API_KEY=
TRADIER_API_KEY=

# --- Pricing assumptions -----------------------------------------------------
# Annualised continuously-compounded risk-free rate used by Black-Scholes.
# Ignored when OPTIONS_FETCH_RISK_FREE_RATE=true.
OPTIONS_RISK_FREE_RATE=0.04
# Fetch the 13-week T-bill (^IRX) and use it as the risk-free rate instead.
OPTIONS_FETCH_RISK_FREE_RATE=false
# Continuous dividend yield assumed for every underlying. See README Limitations.
OPTIONS_DIVIDEND_YIELD=0.0

# --- IV rank -----------------------------------------------------------------
# Trailing window for IV rank/percentile, in stored snapshot days.
OPTIONS_IV_WINDOW_DAYS=252
# Minimum stored days before an IV rank is reported at all. Below this the API
# returns null with a reason rather than a misleading zero.
OPTIONS_MIN_HISTORY_DAYS=20

# --- Storage -----------------------------------------------------------------
# In containers this is sqlite:////data/options.db, on a mounted volume. The
# accumulated IV history is the only irreplaceable state in this project.
OPTIONS_DATABASE_URL=sqlite:///./data/options.db

# --- Daily snapshot ----------------------------------------------------------
# Runs inside the API process; see api/options_tool/scheduler.py for why it is
# not a separate container. Off by default so local runs and tests never fire
# live vendor requests on a timer. TURN THIS ON IN A DEPLOYMENT.
OPTIONS_SNAPSHOT_ENABLED=false
# 24h UTC. 21:15 is after the US equity close in both EST and EDT.
OPTIONS_SNAPSHOT_AT=21:15

# --- Operations --------------------------------------------------------------
# text | json   (json for a deployment whose logs are shipped somewhere)
OPTIONS_LOG_FORMAT=text
# Apply Alembic migrations when the API starts. Idempotent, and it adopts a
# schema created by the CLI rather than failing on it.
OPTIONS_RUN_MIGRATIONS_ON_STARTUP=true
# Browser origins allowed to call the API directly. Leave empty: the front end
# proxies server-side, so no cross-origin request is ever made.
OPTIONS_CORS_ORIGINS=

# --- Web ---------------------------------------------------------------------
# Where the Next.js server reaches the API. Read at request time, never baked
# into the browser bundle, so one built image runs in every environment.
#   local (uvicorn on the host): http://localhost:8000
#   docker compose:             http://api:8000
#   fly.io:                     http://options-analytics-api.internal:8000
API_INTERNAL_URL=http://localhost:8000

# HTTP Basic auth over the entire web app. LEAVE BOTH EMPTY FOR LOCAL DEV — the
# app then runs open. SET BOTH FOR ANY DEPLOYMENT; the API has no public address
# and no auth of its own, so this is the whole authentication story.
# On Fly these are secrets (`fly secrets set`), never committed values.
APP_USERNAME=
APP_PASSWORD=

# Host port for the web app under docker compose.
WEB_PORT=3000
